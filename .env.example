GLPI_URL=http://localhost:8080/apirest.php
GLPI_APP_TOKEN=change-me
GLPI_USER_TOKEN=change-me

# Compte API dédié à l'automatisation (pas le compte admin Sophos), utilisé
# par ansible/playbooks/deploy-firewall-rules.yml. Charger ce fichier avant
# de lancer le playbook : `source .env.local`.
SOPHOS_GENEVE_API_USER=change-me
SOPHOS_GENEVE_API_PASSWORD=change-me
SOPHOS_PARIS_API_USER=change-me
SOPHOS_PARIS_API_PASSWORD=change-me

# Service principal Azure, utilisé à la fois par Terraform (terraform/) et
# par ansible/playbooks/onboard-azure-arc.yml. Mêmes noms de variables que
# le provider azurerm (convention standard Terraform), pour ne pas dupliquer
# les identifiants entre les deux outils. Charger ce fichier avant
# `terraform apply` ou `ansible-playbook onboard-azure-arc.yml`.
ARM_TENANT_ID=change-me
ARM_SUBSCRIPTION_ID=change-me
ARM_CLIENT_ID=change-me
ARM_CLIENT_SECRET=change-me
